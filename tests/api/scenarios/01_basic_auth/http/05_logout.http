### Logout — revokes the refresh token; access token passed as Bearer
# @name logout
POST {{host}}/v1/logout
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
  "token": "{{refresh_token}}"
}

> {%
  client.test("Logout returns 200", () => {
    client.assert(response.status === 200, "Expected 200, got " + response.status);
  });
%}
