### Step 2 — Satisfy the NEW_PASSWORD_REQUIRED challenge
# With COGNITO_ENFORCE_MFA=true the service will then require MFA setup,
# so next_step.step = "mfa_setup" is expected.
# @name set-new-password
POST {{host}}/v1/login/password/update
Cookie: {{session_cookie}}
X-CSRF-Auth-Token: {{csrf_token}}
Content-Type: application/json

{
  "user": "{{username}}",
  "password": "{{new_password}}"
}

> {%
  client.test("Password update returns 200", () => {
    client.assert(response.status === 200, "Expected 200, got " + response.status);
  });
  client.test("Next step is mfa_setup", () => {
    client.assert(response.body.next_step !== undefined, "Missing next_step");
    client.assert(response.body.next_step.step === "mfa_setup",
      "Expected step=mfa_setup, got " + response.body.next_step.step);
  });
  // the login session id travels in the LS cookie and changes when a login succeeds
  const setCookie = [].concat(response.headers.valuesOf ? response.headers.valuesOf("set-cookie") : response.headers.valueOf("set-cookie")).filter(Boolean);
  const sessionCookie = setCookie.map(c => c.split(";")[0]).find(c => c.startsWith("LS="));
  if (sessionCookie) client.global.set("session_cookie", sessionCookie);
%}
