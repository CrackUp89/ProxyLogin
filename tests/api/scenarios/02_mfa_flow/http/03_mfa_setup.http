### Step 3 — Choose software_token as the MFA method to set up
# Cognito calls AssociateSoftwareToken and returns a TOTP secret.
# next_step.step = "mfa_token_setup_verify"
# next_step.payload = base32-encoded TOTP secret
# @name mfa-setup
POST {{host}}/v1/login/mfa/setup
Cookie: {{session_cookie}}
X-CSRF-Auth-Token: {{csrf_token}}
Content-Type: application/json

{
  "user": "{{username}}",
  "mfa_type": "software_token"
}

> {%
  client.test("MFA setup returns 200", () => {
    client.assert(response.status === 200, "Expected 200, got " + response.status);
  });
  client.test("Next step is mfa_token_setup_verify", () => {
    client.assert(response.body.next_step !== undefined, "Missing next_step");
    client.assert(response.body.next_step.step === "mfa_token_setup_verify",
      "Expected step=mfa_token_setup_verify, got " + response.body.next_step.step);
    client.assert(response.body.next_step.payload !== undefined, "Missing TOTP secret in payload");
  });
  // the login session id travels in the LS cookie and changes when a login succeeds
  const setCookie = [].concat(response.headers.valuesOf ? response.headers.valuesOf("set-cookie") : response.headers.valueOf("set-cookie")).filter(Boolean);
  const sessionCookie = setCookie.map(c => c.split(";")[0]).find(c => c.startsWith("LS="));
  if (sessionCookie) client.global.set("session_cookie", sessionCookie);
  client.global.set("totp_secret", response.body.next_step.payload);
%}
