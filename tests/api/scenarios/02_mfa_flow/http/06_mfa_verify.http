### Step 6 — Submit TOTP code to complete login
# Pre-request script regenerates a fresh TOTP code (same secret as step 4).
# On success, auth_result contains the final token set.
# @name mfa-verify
POST {{host}}/v1/login/mfa/verify
Cookie: {{session_cookie}}
X-CSRF-Auth-Token: {{csrf_token}}
Content-Type: application/json

< {%
  const { TOTP, Secret } = require('otpauth');
  const secret = client.global.get('totp_secret');
  const totp = new TOTP({
    issuer: 'ProxyLogin',
    label: client.global.get('username') || 'test',
    algorithm: 'SHA1',
    digits: 6,
    period: 30,
    secret: Secret.fromBase32(secret),
  });
  client.global.set('totp_code', totp.generate());
%}

{
  "user": "{{username}}",
  "code": "{{totp_code}}"
}

> {%
  client.test("MFA verify returns 200", () => {
    client.assert(response.status === 200, "Expected 200, got " + response.status);
  });
  client.test("Login is complete after MFA verify", () => {
    client.assert(response.body.auth_result !== undefined, "Missing auth_result");
    client.assert(response.body.auth_result.login_type === "token_set", "Expected login_type=token_set");
    client.assert(response.body.auth_result.login_data.access_token !== undefined, "Missing access_token");
  });
  client.global.set("access_token", response.body.auth_result.login_data.access_token);
  client.global.set("refresh_token", response.body.auth_result.login_data.refresh_token);
%}
